# Rename to `lspd.local.toml` (untracked, per the recommended
# .gitignore entry) to try a local override: switching pyright out for
# basedpyright without touching the committed `lspd.toml` at all.

[lsps]
enabled = ["basedpyright", "ruff"]

[lsp.basedpyright]
command = ["basedpyright-langserver", "--stdio"]
languages = ["python"]
